    {
      "ordinal": 2,
      "depth": 0,
      "kind": "section",
      "number": "1",
      "title": "Implementation",
      "body": "The document has been created and approved by the General Assembly of 09.11.2024.\nThe document and its rules have been implemented since the 2025 season.",
