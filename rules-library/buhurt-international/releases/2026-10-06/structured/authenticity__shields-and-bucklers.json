    {
      "ordinal": 23,
      "depth": 1,
      "kind": "rule",
      "number": "9.1",
      "title": "Historical Sources and Datation",
      "body": "Bucklers are small round Shields made of wood or metal. They do not have straps but a rigid handle and a Shield boss (umbo).\nThey are Approved for 14th century, Transitional and 15th century armors.\n\nWeltchronik in Versen - 1370 - Germany",
      "page_from": 17,
      "page_to": 17,
      "stable_key": "shields-and-bucklers:9.1",
      "parent_key": "shields-and-bucklers:9",
