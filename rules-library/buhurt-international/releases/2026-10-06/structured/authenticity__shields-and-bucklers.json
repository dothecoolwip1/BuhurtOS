    {
      "ordinal": 18,
      "depth": 1,
      "kind": "rule",
      "number": "8.1",
      "title": "Historical Sources and Datation",
      "body": "Round Shields were very common in the early 14th century, and became rare while other designs spread.\nThey are mainly made of wood. Some examples of metal round Shields exist but they are parade Shields and should be worn only with the proper set of armor of the late 15th century.\nRound Shields are worn with straps made of leather.\nThey are Approved for 14th century and Transitional armors.\nThey are Denied for 15th century armors unless historical sources are provided.\n\nRoman de la Rose - 1350 - France\n\nCathedral of Strasbourg - 1340 - France",
      "page_from": 15,
      "page_to": 15,
      "stable_key": "shields-and-bucklers:8.1",
      "parent_key": "shields-and-bucklers:8",
      "review_status": "extracted",
      "review_note": null,
