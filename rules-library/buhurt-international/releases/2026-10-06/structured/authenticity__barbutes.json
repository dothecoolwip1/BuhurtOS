      ]
    },
    {
      "ordinal": 9,
      "depth": 1,
      "kind": "rule",
      "number": "4.2",
      "title": "Visor",
      "body": "Visors must not be too long or too short, it must respect the proportions of historical sources.\n\nIt is allowed to add a metal plate to protect the throat. Such a plate must be strong enough to endure full contact fight and must be concealed under the aventail.",
      "page_from": 7,
      "page_to": 7,
      "stable_key": "barbutes:4.2",
      "parent_key": "barbutes:4",
