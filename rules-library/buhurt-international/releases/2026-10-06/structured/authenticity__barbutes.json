    {
      "ordinal": 8,
      "depth": 1,
      "kind": "rule",
      "number": "4.1",
      "title": "General Requirements",
      "body": "Reproductions must closely resemble the appearance and proportions of historical sources.\n\nA particular attention must be paid to the crest on top of the Barbute, often forgotten by modern armorers.\n\nAny metal part of the helmet must conform to the “Armors and Weapons Aesthetics and Decorations document.\n\nAny textile or leather part of the helmet must conform to the “Textiles and Leather” document.",
      "page_from": 7,
      "page_to": 7,
      "stable_key": "barbutes:4.1",
      "parent_key": "barbutes:4",
      "review_status": "extracted",
      "review_note": null,
