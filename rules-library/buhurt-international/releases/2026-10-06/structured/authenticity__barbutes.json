      ]
    },
    {
      "ordinal": 10,
      "depth": 1,
      "kind": "rule",
      "number": "4.3",
      "title": "Eyes and Mouth slot",
      "body": "Eyes and Mouth slots must resemble sources for the visor (T shape or Y shape).\nEyes and Mouth slots should not exceed 25 mm tall to prevent any injury, as a safety recommendation.\nIt is Allowed to add:\n\n● Up to five (5) safety Eye bars: one (1) in the middle and two (2) on each side of the Eye slots,\n● Up to five (5) safety Eye bars on the mouth slot, It is allowed to use a T shaped-Eye bar at the junction of the Eye slots and the Mouth slot.\n\nIt is allowed to use slanted safety Eye bars for barbute with Y shape only.\nEye bars must be welded internally or riveted internally.\nEye bars must conform to the “Eye bars” document.",
      "page_from": 7,
      "page_to": 7,
      "stable_key": "barbutes:4.3",
      "parent_key": "barbutes:4",
      "review_status": "extracted",
