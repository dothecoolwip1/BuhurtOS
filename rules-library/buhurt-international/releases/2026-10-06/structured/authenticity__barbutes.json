      "keywords": [],
      "cross_refs": [],
      "content_sha256": "25e425ee27fb09506da52e4418cdd4a5fdbc5be8e35ae9414deec9953b7520bc",
      "has_figures": false,
      "extraction": "ocr",
      "lines": [
