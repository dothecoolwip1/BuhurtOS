    {
      "ordinal": 8,
      "depth": 1,
      "kind": "rule",
      "number": "4.1",
      "title": "General Requirements",
      "body": "Reproductions must closely resemble the appearance and proportions of a Nasal or a Breteche helmet source.\n\nAny metal part of the helmet must conform to the “Armors and Weapons Aesthetics and Decorations” document.\n\nAny textile or leather part of the helmet must conform to the “Textiles and Leather” document.",
      "page_from": 6,
      "page_to": 6,
      "stable_key": "nasals-and-breteches:4.1",
      "parent_key": "nasals-and-breteches:4",
      "review_status": "extracted",
