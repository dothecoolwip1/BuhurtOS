    {
      "ordinal": 7,
      "depth": 1,
      "kind": "rule",
      "number": "5.1",
      "title": "Historical Sources and Datation",
      "body": "Miniatures sometimes display a small shield attached to the Aventail, mainly during the 14th century.\nThose shields were supposed to show the heraldry of the wearer. Thus, as Neck protection is mandatory in our sport, such neck shields are allowed to be worn on the Aventail.\n\nThey are Approved for 14th century, Transitional and 15th century armors.\n\nBook of Hours - 1320 - The Netherlands",
      "page_from": 5,
      "page_to": 5,
      "stable_key": "neck-protection:5.1",
      "parent_key": "neck-protection:5",
      "review_status": "extracted",
