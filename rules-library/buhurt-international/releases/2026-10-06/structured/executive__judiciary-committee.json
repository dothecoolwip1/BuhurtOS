      "ordinal": 31,
      "depth": 1,
      "kind": "rule",
      "number": "4.1",
      "title": "Make sure you fully understand the nature of the sanction imposed. Review any",
      "body": "relevant documentation such as emails or notifications that explain the reasons for the sanction and the available appeal terms. Any relevant evidence that supports your appeal must be shown, like screenshots, emails, videos, or any other documentation showing that the penalty was unfair or incorrect.",
      "page_from": 7,
      "page_to": 7,
