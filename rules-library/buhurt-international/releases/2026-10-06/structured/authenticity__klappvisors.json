      ]
    },
    {
      "ordinal": 9,
      "depth": 1,
      "kind": "rule",
      "number": "4.2",
      "title": "Visor",
      "body": "Visors must not be too long or too short, it must respect the proportions of historical sources.\nThe hinge must be reproduced as per historical sources.\n\nIt is Allowed to weld the hinge. Welded hinges must resemble a functional hinge.\n\nIt is Allowed to weld the visor down. Welded visors must resemble a functional removable visor.\n\nIt is Allowed to add a metal plate to protect the throat. Such a plate must be strong enough to endure full contact fight and must be concealed under the Aventail.\n\nA leather strap can be used to secure the visor down.\n\nBreath holes should be round and must not exceed a diameter of 10mm. Breath holes must not be so numerous that they compromise the helm’s structural integrity. It is acceptable to mirror breath holes to both sides.\n\nBreath holes of another shape must be documented by historical sources to be allowed.",
      "page_from": 8,
      "page_to": 8,
      "stable_key": "klappvisors:4.2",
      "parent_key": "klappvisors:4",
      "review_status": "extracted",
