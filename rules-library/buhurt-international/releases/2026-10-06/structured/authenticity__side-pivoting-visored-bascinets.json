    {
      "ordinal": 5,
      "depth": 1,
      "kind": "rule",
      "number": "3.1",
      "title": "14th Century Sugarloaf Helmets",
      "body": "Sugarloaf helmets are one of the earliest types of Side-pivoting visored Bascinets. It appeared at the beginning of the 14th century and includes a solid chin protection, derived from Great helms design.\n\nSugarloaf helmets are Approved for 14th century armors.\nSugarloaf helmets are Denied for Transitional and 15th century armors.\n\nBL Royal 6 E IX Address in verse to Robert of Anjou, King of Naples - 1335/1340 - Italy",
      "page_from": 4,
      "page_to": 4,
      "stable_key": "side-pivoting-visored-bascinets:3.1",
      "parent_key": "side-pivoting-visored-bascinets:3",
      "review_status": "extracted",
      "review_note": null,
