    {
      "ordinal": 11,
      "depth": 1,
      "kind": "rule",
      "number": "4.1",
      "title": "General Requirements",
      "body": "Reproductions must closely resemble the appearance and proportions of a Side-pivoting Bascinet source.\n\nAny metal part of the helmet must conform to the “Armors and Weapons Aesthetics and Decorations” document.\n\nAny textile or leather part of the helmet must conform to the “Textiles and Leather” document.",
      "page_from": 8,
      "page_to": 8,
      "stable_key": "side-pivoting-visored-bascinets:4.1",
      "parent_key": "side-pivoting-visored-bascinets:4",
      "review_status": "extracted",
      "review_note": null,
