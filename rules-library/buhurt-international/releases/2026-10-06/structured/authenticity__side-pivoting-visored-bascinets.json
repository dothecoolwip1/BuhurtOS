    {
      "ordinal": 14,
      "depth": 1,
      "kind": "rule",
      "number": "4.4",
      "title": "Aventail",
      "body": "Side-pivoting visored Bascinets must be worn with chainmail Aventails, fabric Aventails, or scales Aventails.\nAventails must conform to the “Aventails” document.\n\nAventails must be attached to the Bascinet by a system of leather and vervelles, or sewn to the edges of the helmet.\n\nChainmail Aventail must be fastened down to the edge of a padded pelerine, attached to the helmet liner.\n\nScales and fabric Aventails are recommended to be fastened down to the edge of a padded pelerine, attached to the helmet liner.\n\nAny additional protective plates covering the cervical spine should be hidden under the Aventail.",
      "page_from": 9,
      "page_to": 9,
      "stable_key": "side-pivoting-visored-bascinets:4.4",
