    {
      "ordinal": 4,
      "depth": 1,
      "kind": "rule",
      "number": "2.1",
      "title": "Definition",
      "body": "“Falchion” is the term used to describe a single-edged bladed weapon from the Middle Ages in Europe.\nThe falchion originated in the 12th century and evolved until the 15th century.\nFalchions can be one-handed or two-handed.\n“Messer” is the term used to describe a specific subtype of falchion.",
      "page_from": 3,
      "page_to": 3,
      "stable_key": "falchions:2.1",
      "parent_key": "falchions:2",
      "review_status": "extracted",
      "review_note": null,
      "topics": [],
      "keywords": [],
      "cross_refs": [],
      "content_sha256": "abeabd16624e8fcbca82ae198a5324a19cb6f839bfced369ce254b4b0a5eb53c",
      "has_figures": false,
      "extraction": "text",
      "lines": [
        "3:8",
        "3:9",
