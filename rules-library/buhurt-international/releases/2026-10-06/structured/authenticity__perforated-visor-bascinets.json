    {
      "ordinal": 12,
      "depth": 1,
      "kind": "rule",
      "number": "4.3",
      "title": "Aventails",
      "body": "Bascinets with perforated visors must be worn with chainmail aventails, fabric aventails, or scales aventails.\nGreat Bascinets and Bicoques can not be worn with chainmail aventails, fabric aventails or scales aventails.\nAventails must conform to the “Aventails” document.\nAventails must be attached to the bascinet by a system of leather and vervelles.\nThe aventail must be fastened down to the edge of a padded pelerine attached to the helmet liner.\nAny additional protective plates covering the cervical spine must be hidden under the aventail.",
      "page_from": 8,
      "page_to": 8,
      "stable_key": "perforated-visor-bascinets:4.3",
