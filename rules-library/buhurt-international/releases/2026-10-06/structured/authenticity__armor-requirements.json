    {
      "ordinal": 35,
      "depth": 1,
      "kind": "rule",
      "number": "5.8",
      "title": "Feet",
      "body": "Feet must be protected with metal plates, commonly called sabatons.\n\nSabatons must conform to the “Sabatons” document.\n\nSabatons must cover the top part of the foot (including tarsal and metatarsals) and toes.\n\nSabatons must be well attached to the shoes by leather laces or any other authentical material (rope, linen thread for example).",
      "page_from": 9,
      "page_to": 9,
