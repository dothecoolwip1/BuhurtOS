    {
      "ordinal": 28,
      "depth": 1,
      "kind": "rule",
      "number": "5.1",
      "title": "Metal Thickness Recommendations",
      "body": "The minimum recommended thickness for steel plates of an armor is 1.5 mm (mild steel) or 0.8 mm (tempered steel, hardened steel, stainless steel).\n\nThe minimum recommended thickness for titanium plates of an armor is 0.8 mm.",
      "page_from": 8,
      "page_to": 8,
      "stable_key": "armor-requirements:5.1",
      "parent_key": "armor-requirements:5",
      "review_status": "extracted",
