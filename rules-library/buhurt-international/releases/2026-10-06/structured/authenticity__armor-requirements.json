    {
      "ordinal": 23,
      "depth": 1,
      "kind": "rule",
      "number": "4.2",
      "title": "Thickness and Composition",
      "body": "Dome and visor must be made of metal.\nIt is recommended to use steel (mild, tempered, hardened or stainless).\nAny other material (I.e titanium) is not permitted.\nVisors may be made of titanium.\nA helmet can be made of steel of varying thicknesses.\nRecommend minimum thicknesses:\n● 2.5mm mild steel / spring steel.\n● 2.5mm stainless steel.\n● 2.0mm tempered steel / hardened steel.",
      "page_from": 6,
      "page_to": 6,
