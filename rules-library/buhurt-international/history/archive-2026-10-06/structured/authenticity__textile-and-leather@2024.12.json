    {
      "ordinal": 4,
      "depth": 1,
      "kind": "rule",
      "number": "1.2",
      "title": "Textiles and leather",
      "body": "● Textiles and leather are part of a knightly appearance. Tabards are made of fabric (linen, wool, silk…), coats of plates are covered with fabric, leather is mainly used for armor (helmet suspension, belts, pouches, straps), etc. All skin must be covered.",
      "page_from": 3,
      "page_to": 3,
      "stable_key": "textile-and-leather:1.2",
      "parent_key": "textile-and-leather:1",
      "review_status": "extracted",
