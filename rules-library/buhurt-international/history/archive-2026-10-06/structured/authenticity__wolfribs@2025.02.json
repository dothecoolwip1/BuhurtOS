    {
      "ordinal": 8,
      "depth": 1,
      "kind": "rule",
      "number": "3.3",
      "title": "Eye-slots",
      "body": "● It is not recommended to have oversized eye slots (over 30x50mm).\n● It is permitted to add up to four (4) vertical safety eyebars on the visor: two (2) on each side of the visor.\n● Eyebars must conform to the Eye Bars rules document.",
      "page_from": 5,
      "page_to": 5,
      "stable_key": "wolfribs:3.3",
      "parent_key": "wolfribs:3",
