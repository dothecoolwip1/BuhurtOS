      ]
    },
    {
      "ordinal": 7,
      "depth": 1,
      "kind": "rule",
      "number": "3.2",
      "title": "Visor Requirements",
      "body": "● The visor must not be too long or too short and respect the proportions of historical sources.\n● The hinge must be reproduced as per historical sources.\n● It is permitted to weld the hinge. Welded hinges must resemble a functional hinge.\n● It is permitted to weld the visor down. A welded visor must resemble a functional removable visor.\n● It is permitted to add a metal plate to protect the throat. Such a plate must be strong enough to endure full contact fight and must be concealed under the aventail.\n● The visor must consist of 5 horizontal ribs.\n● Ribs must be round or bar-shaped.\n● Ribs can not be made of flat sheets.",
      "page_from": 5,
      "page_to": 5,
      "stable_key": "wolfribs:3.2",
      "parent_key": "wolfribs:3",
      "review_status": "extracted",
