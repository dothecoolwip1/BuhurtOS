    {
      "ordinal": 9,
      "depth": 1,
      "kind": "rule",
      "number": "3.4",
      "title": "Aventail",
      "body": "● Wolf ribs helmets can be worn with chainmail or fabric aventails. Scale aventails are not permitted.\n● Aventails must conform to the Aventails document.\n● The aventail must be fastened down to the outer edge of a padded pelerine attached to the helmet liner.\n● Protective plates covering the cervical spine should be hidden under the aventail.\nSupplemental hidden collar plates are permitted.",
      "page_from": 5,
      "page_to": 5,
