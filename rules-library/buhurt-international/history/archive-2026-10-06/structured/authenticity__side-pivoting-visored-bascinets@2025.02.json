    {
      "ordinal": 14,
      "depth": 1,
      "kind": "rule",
      "number": "3.4",
      "title": "Aventail",
      "body": "● Side-hinged visored bascinets must be worn with chainmail aventails, fabric aventails, or scale aventails.\n● Aventails must conform to the Aventails document.\n● Aventails must be attached to the bascinet by a system of leather and vervelles, or sewn to the edges of the helmet.\n● The aventail must be fastened down to the outer edge of a padded pelerine attached to the helmet liner.\n● Protective plates covering the cervical spine should be hidden under the aventail.\nSupplemental hidden collar plates are permitted.",
      "page_from": 9,
      "page_to": 9,
      "stable_key": "side-pivoting-visored-bascinets:3.4",
