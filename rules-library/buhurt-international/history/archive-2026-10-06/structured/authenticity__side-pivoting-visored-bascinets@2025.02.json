    {
      "ordinal": 5,
      "depth": 1,
      "kind": "rule",
      "number": "2.1",
      "title": "14th Century Sugarloaf Helmets",
      "body": "● Sugarloaf helmets are one of the earliest types of side-hinged visored bascinets. It appeared at the beginning of the 14th century and includes a solid chin protection, derived from Great Helms design.\n● Sugarloaf helmets are approved for 14th-century armor.\n● Sugarloaf helmets are denied for transitional armor and 15th-century armor.\n\nBL Royal 6 E IX Address in verse to Robert of Anjou, King of Naples - 1335/1340 - Italy",
      "page_from": 4,
      "page_to": 4,
      "stable_key": "side-pivoting-visored-bascinets:2.1",
      "parent_key": "side-pivoting-visored-bascinets:2",
