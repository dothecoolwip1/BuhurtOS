    {
      "ordinal": 11,
      "depth": 1,
      "kind": "rule",
      "number": "3.1",
      "title": "General Requirements",
      "body": "● Reproductions must closely resemble the appearance and proportions of a side-hinged bascinet source.\n● Any metal part of the helmet must conform to the Armors and Weapons aesthetics and decorations document.\n● Any textile or leather part of the helmet must conform to the Textiles and Leather document.",
      "page_from": 8,
