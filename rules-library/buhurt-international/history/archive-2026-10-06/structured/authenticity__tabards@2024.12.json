    {
      "ordinal": 3,
      "depth": 1,
      "kind": "rule",
      "number": "1.1",
      "title": "Definition",
      "body": "● Tabards is a generic term used to describe the cloth worn upon the armor. It is made to show the heraldry of the wearer and prove your wealth and status on the battlefield, or in the list.\n● Nowadays, tabards have the same function as a sports jersey: to indicate the team you belong to.",
      "page_from": 3,
      "page_to": 3,
      "stable_key": "tabards:1.1",
      "parent_key": "tabards:1",
      "review_status": "extracted",
      "review_note": null,
