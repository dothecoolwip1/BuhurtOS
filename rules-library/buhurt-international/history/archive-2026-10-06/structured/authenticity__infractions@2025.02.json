      ]
    },
    {
      "ordinal": 5,
      "depth": 1,
      "kind": "rule",
      "number": "2.2",
      "title": "Moderate Infraction",
      "body": "It is something forbidden by the Authenticity rules (i.e badly designed helmet, over numerous eye bars etc.). Not respecting the rules can't be accepted, thus it is not severe enough to prevent the fighter from entering the list.",
      "page_from": 3,
      "page_to": 3,
      "stable_key": "infractions:2.2",
