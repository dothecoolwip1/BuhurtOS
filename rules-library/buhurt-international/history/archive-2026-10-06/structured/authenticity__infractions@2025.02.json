    {
      "ordinal": 4,
      "depth": 1,
      "kind": "rule",
      "number": "2.1",
      "title": "Minor infraction",
      "body": "It is a small detail not easy to see, and it does not affect the coherence of the whole armor (small traces of rust, hammering marks, little datation difference between 2 parts etc.).",
      "page_from": 3,
      "page_to": 3,
      "stable_key": "infractions:2.1",
      "parent_key": "infractions:2",
      "review_status": "extracted",
      "review_note": null,
