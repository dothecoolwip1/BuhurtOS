    {
      "ordinal": 7,
      "depth": 0,
      "kind": "section",
      "number": "3",
      "title": "Application of the rules",
      "body": "● A violation of the authenticity rules will result in a green card. Depending on the rank of tournament, infraction will be applied differently.\n\n● A green card combined with a yellow card will result in a red card and the competitor will be disqualified from the tournament.\n\n● A competitor can receive only 1 green card per tournament, no matter how many infractions they have.",
      "page_from": 4,
      "page_to": 4,
      "stable_key": "infractions:3",
      "parent_key": null,
