    {
      "ordinal": 3,
      "depth": 0,
      "kind": "section",
      "number": "2",
      "title": "Infraction classification",
      "body": "During Authenticity Check, Authenticity officers will evaluate the entire equipment of competitors before the start of the tournament. Any violation of the Authenticity rules will result in an infraction.\nInfractions can be classified under 3 different levels:",
      "page_from": 3,
      "page_to": 3,
      "stable_key": "infractions:2",
      "parent_key": null,
      "review_status": "extracted",
      "review_note": null,
