    {
      "ordinal": 6,
      "depth": 1,
      "kind": "rule",
      "number": "2.3",
      "title": "Major infraction",
      "body": "Fantasy armor or totally inaccurate equipment, that prevent the fighter from entering the list and damage the image of the sport, the teams and Buhurt International.",
