    {
      "ordinal": 9,
      "depth": 1,
      "kind": "rule",
      "number": "3.4",
      "title": "Aventail",
      "body": "● Great helms can be worn with chainmail or scale aventails. Fabric aventails are not allowed.\n● Aventails must conform to the Aventail Rules.\n● Great helms can not have a suspension system made of vervelles and leather. Chainmail should be affixed to the interior of the helmet.\n● Protective plates covering the cervical spine must be hidden under the aventail.",
      "page_from": 6,
      "page_to": 6,
      "stable_key": "great-helms:3.4",
      "parent_key": "great-helms:3",
