    {
      "ordinal": 7,
      "depth": 1,
      "kind": "rule",
      "number": "3.2",
      "title": "Visor Requirements",
      "body": "● The visor must not be too long or too short, it must respect the proportions of historical sources.\n● Breath holes should be round and consistently sized unless documented by the source.\nBreath holes must not be so numerous that they compromise the helm’s structural integrity. It is acceptable to mirror breath holes to both sides.",
      "page_from": 5,
      "page_to": 5,
      "stable_key": "great-helms:3.2",
      "parent_key": "great-helms:3",
      "review_status": "extracted",
