    {
      "ordinal": 9,
      "depth": 1,
      "kind": "rule",
      "number": "3.1",
      "title": "General Requirements",
      "body": "● Reproductions must closely resemble the appearance and proportions of a Klappvisor source.\n● Any metal part of the helmet must conform to the Armors and weapons Aesthetics and decorations document.\n● Any textile or leather part of the helmet must conform to the Textiles and Leather document.",
      "page_from": 8,
      "page_to": 8,
      "stable_key": "klappvisors:3.1",
      "parent_key": "klappvisors:3",
      "review_status": "extracted",
