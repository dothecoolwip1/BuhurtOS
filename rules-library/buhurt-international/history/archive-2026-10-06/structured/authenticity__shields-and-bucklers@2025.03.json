    {
      "ordinal": 4,
      "depth": 1,
      "kind": "rule",
      "number": "1.1",
      "title": "Definition",
      "body": "● Shields and bucklers are the terms used to describe every protection made of wood or steel and designed to protect yourself.",
      "page_from": 3,
      "page_to": 3,
      "stable_key": "shields-and-bucklers:1.1",
      "parent_key": "shields-and-bucklers:1",
