      ]
    },
    {
      "ordinal": 5,
      "depth": 1,
      "kind": "rule",
      "number": "1.2",
      "title": "Shields and bucklers description",
      "body": "Shields and bucklers can be:\n● Heater shields : Shields made of triangular shape, the most common shape of shields from the XIIIth century and beyond. They must be made of wood.\n● Punch shields : Punch shields primarily designed to hit the opponent. It includes a wide variety of shapes. They must be made of wood.\n● Round shields : Shields made of a round shape, very common throughout the middle ages.\nThey can be made of wood or metal.\n● Bucklers : Small round shape shields with central handle, mainly used in duels and as a secondary equipment for close defense. They can be made of wood or metal.",
      "page_from": 3,
      "page_to": 3,
      "stable_key": "shields-and-bucklers:1.2",
      "parent_key": "shields-and-bucklers:1",
      "review_status": "extracted",
      "review_note": null,
      "topics": [],
      "keywords": [],
      "cross_refs": [],
      "content_sha256": "f73af5b9a083a8719c64655b81da919f58eeec16a848b02db1e3f5cc35df71e9",
      "has_figures": false,
