    {
      "ordinal": 20,
      "depth": 1,
      "kind": "rule",
      "number": "4.1",
      "title": "Historical sources and datation",
      "body": "● Round shields were very common in the early 14th century, and became rare while other designs spread. They are mainly made of wood. Some examples of metal round shields exist but they are parade shields and should be worn only with the proper set of armor of the late 15th century.\n● Round shields are worn with straps made of leather.\n● They are approved for 14th century and Transitional armors.\n● They are denied for 15th century armors unless historical sources are provided.\n\nCathedral of Strasbourg - 1340 - France Roman de la Rose - 1350 - France",
      "page_from": 15,
      "page_to": 15,
      "stable_key": "shields-and-bucklers:4.1",
      "parent_key": "shields-and-bucklers:4",
      "review_status": "extracted",
      "review_note": null,
      "topics": [],
      "keywords": [],
      "cross_refs": [],
      "content_sha256": "8362cfff2f1adc43f6a7a60e312928762d6d16928bf81cf54fe65009dc4593f5",
      "has_figures": true,
      "extraction": "text",
