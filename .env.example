# Copy to .env.local for local development. Nothing here is a secret that must stay off the browser: these are PUBLISHABLE keys.
# Supabase (defaults in src/lib/supabase.ts point at the hosted project).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Google Maps Platform BROWSER key for venue/address autocomplete on the event setup screens (docs/runbooks/GOOGLE_PLACES.md).
# Optional: leave empty and the venue fields stay plain text. Restrict the key to your site's domains and to the Maps JavaScript API +
# Places API (New) before pasting it here; never put a server key in this file.
VITE_GOOGLE_MAPS_BROWSER_KEY=
