{
  "name": "buhurtos-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "nacl:gen": "rolldown scripts/testLeague/generate.ts --format esm --platform node -d node_modules/.cache/nacl && node node_modules/.cache/nacl/generate.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "posthog-js": "1.435.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
